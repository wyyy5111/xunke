{
  "name": "xunkeflow-desktop",
  "version": "1.1.0",
  "description": "循课 XunkeFlow 独立桌面版",
  "main": "main.cjs",
  "author": "XunkeFlow Team",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg --arm64",
    "dist:mac:arm64": "electron-builder --mac dmg --arm64",
    "dist:mac:x64": "electron-builder --mac dmg --x64",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "43.1.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "cn.xunkeflow.desktop",
    "productName": "循课 XunkeFlow",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "loading.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend_dist"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "assets/AppIcon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ],
      "extraResources": [
        {
          "from": "build/backend-macos/XunkeFlowBackend",
          "to": "backend/XunkeFlowBackend"
        },
        {
          "from": "../demo_data",
          "to": "assets/demo_data"
        }
      ],
      "artifactName": "XunkeFlow_macOS_${version}_${arch}.${ext}"
    },
    "dmg": {
      "title": "循课 XunkeFlow ${version}",
      "backgroundColor": "#071225",
      "window": {
        "width": 660,
        "height": 440
      },
      "contents": [
        { "x": 180, "y": 220, "type": "file" },
        { "x": 480, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "extraResources": [
        {
          "from": "runtime/windows",
          "to": "backend-windows"
        }
      ],
      "artifactName": "XunkeFlow_Windows_${version}_${arch}_Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "循课 XunkeFlow",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": ["zh_CN", "en_US"],
      "language": "2052"
    }
  }
}
