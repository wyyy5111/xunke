{
  "name": "xunkeflow-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:showcase": "vue-tsc --noEmit && vite build --mode showcase",
    "dev:showcase": "vite --mode showcase"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.6.8",
    "dompurify": "^3.0.11",
    "echarts": "6.1.0",
    "element-plus": "^2.7.0",
    "github-markdown-css": "^5.9.0",
    "marked": "^12.0.1",
    "mermaid": "^11.16.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-echarts": "8.0.1",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "vue-tsc": "^2.0.7"
  },
  "overrides": {
    "glob": "10.5.0",
    "happy-dom": "20.8.9"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
