# XunkeFlow environment template
# Copy this file to .env. Never place a real credential in this template.

# Application
APP_NAME=XunkeFlow
APP_ENV=dev
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Shanghai
# Optional Docker host-port overrides (container ports remain 8000 and 8080).
# Defaults bind only to the local machine. Set either bind address to 0.0.0.0
# explicitly only when a trusted LAN demonstration really needs remote access.
BACKEND_BIND=127.0.0.1
FRONTEND_BIND=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Optional build-only Python package index override for restricted networks.
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org
# Local demonstration only. APP_ENV=production disables automatic seed regardless of this value.
AUTO_SEED_DEMO=true

# Storage (paths are resolved from the project root in local development)
DATABASE_URL=sqlite:///./data/xunkeflow.db
UPLOAD_DIR=./data/uploads
CHUNK_DIR=./data/chunks
MAX_UPLOAD_MB=50

# Authentication
# Replace this value before any shared or production deployment.
JWT_SECRET=replace-with-a-random-string-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
JWT_ISSUER=xunkeflow
JWT_AUDIENCE=xunkeflow-web
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_REGISTER_MAX_REQUESTS=10
AUTH_REGISTER_WINDOW_SECONDS=3600

# Local retrieval. Course chunks are persisted in SQLite and ranked locally.
VECTOR_STORE=sqlite_tfidf

# AI engine
# Supported providers: mock, deepseek
# DeepSeek requests are hard-limited to deepseek-v4-flash. Pro or any other
# model value is rejected at startup; it is never silently rewritten.
LLM_PROVIDER=mock
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.4

# Browser origins allowed to call the backend directly in local development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
